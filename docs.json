              "getting-started/free-forever"
            ]
          },
          {
            "group": "Account & security",
            "pages": [
              "account/signup",
              "account/google-login",
              "account/passkeys",
              "account/mfa",
              "account/card-verification"
            ]
          },
          {
            "group": "Customer onboarding",
            "pages": [
              "customer-management/onboard-customer",
              "customer-management/portal-modes",
              "customer-management/whitelabel-subdomain",
              "customer-management/custom-domain",
              "customer-management/email-domains"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "agents/retell/import-retell-agent",
              "agents/vapi/import-vapi-agent"
            ]
          }
