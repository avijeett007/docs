        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "MCP APIs",
            "pages": [
              "api-reference/mcp/introduction",
              "api-reference/mcp/authentication",
              "api-reference/mcp/endpoints"
            ]
          },
          {
            "group": "More API specs",
            "pages": [
              "api-reference/future-specs"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
